{
  "manifest_version": 3,
  "name": "Ass extension test",
  "version": "1.0",
  "description": "Test extension for Ass: checks which extension APIs work in the browser.",
  "key": "",
  "background": { "service_worker": "sw.js" },
  "permissions": [
    "storage", "tabs", "scripting", "declarativeNetRequest",
    "declarativeNetRequestFeedback", "alarms", "contextMenus", "cookies", "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "all_frames": true,
      "js": ["config.js", "lib.js", "cs_start.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "all_frames": true,
      "js": ["config.js", "lib.js", "cs_idle.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "static_rules", "enabled": true, "path": "rules.json" }
    ]
  },
  "action": { "default_popup": "popup.html", "default_title": "Ass extension test" },
  "options_page": "options.html",
  "commands": {
    "ass-test-command": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Test command"
    }
  }
}
